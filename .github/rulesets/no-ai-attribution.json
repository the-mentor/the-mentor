{
  "name": "No AI attribution in commits",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~ALL"], "exclude": [] } },
  "bypass_actors": [],
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "No AI attribution trailers",
        "negate": true,
        "operator": "regex",
        "pattern": "([Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|[Aa]nthropic)|[Cc]laude-[Ss]ession:|noreply@anthropic\\.com)"
      }
    },
    {
      "type": "commit_author_email_pattern",
      "parameters": {
        "name": "No Anthropic author email",
        "negate": true,
        "operator": "contains",
        "pattern": "noreply@anthropic.com"
      }
    },
    {
      "type": "committer_email_pattern",
      "parameters": {
        "name": "No Anthropic committer email",
        "negate": true,
        "operator": "contains",
        "pattern": "noreply@anthropic.com"
      }
    }
  ]
}
